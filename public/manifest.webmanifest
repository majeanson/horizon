    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ma réponse", "short_name": "Réponse", "description": "L’âge le plus tôt où l’argent dure", "url": "/resultats", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Mon profil", "short_name": "Profil", "description": "Vos chiffres, saisis à la main", "url": "/profil", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Ma fiche", "short_name": "Fiche", "description": "Votre situation en cinq mesures", "url": "/fiche", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
