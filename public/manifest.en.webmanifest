{
  "id": "/",
  "name": "Horizon — when can you retire?",
  "short_name": "Horizon",
  "description": "At what age can you retire? A planner for Québec, calculated on the official parameters. Your data stays on your device.",
  "lang": "en",
  "categories": ["finance", "productivity"],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
