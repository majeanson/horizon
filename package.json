{
  "name": "horizon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quand la retraite ? — Québec/Canada retirement-date planner. Local-only data; CF Worker serves static assets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run src/engine",
    "test:fast": "vitest run --exclude \"**/node_modules/**\" --exclude \"**/{answer.props,answerTrust,orderNudge,presetEffects,savingsNeeded,sheetCopy,probes,perfBudget,schemaExtremes}.test.ts\"",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage.enabled",
    "mutate": "node scripts/mutate.mjs",
    "stryker": "node scripts/stryker.mjs",
    "specs-for": "node scripts/specs-for.mjs",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --workers=1 --retries=0 --forbid-only",
    "e2e:slow": "playwright test -c playwright.slow.config.ts",
    "e2e:sw": "playwright test -c e2e/sw.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:bundle",
    "sources": "node scripts/gen-sources.ts",
    "examples": "node scripts/gen-examples.ts",
    "og": "node scripts/gen-og.ts",
    "sources:check": "node scripts/check-sources.ts",
    "figures:check": "node scripts/check-figures.ts",
    "knip": "knip",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^21.0.4",
    "jsqr": "^1.4.0",
    "knip": "^6.47.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.11",
    "wrangler": "^4.166.0"
  }
}
